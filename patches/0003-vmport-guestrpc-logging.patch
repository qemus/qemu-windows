diff --git a/hw/i386/vmport.c b/hw/i386/vmport.c
--- a/hw/i386/vmport.c
+++ b/hw/i386/vmport.c
@@ -42,6 +42,36 @@
 
 #define VMPORT_MAGIC   0x564D5868
 
+/* Low-bandwidth VMware GuestRPC protocol used by RPCI. */
+#define VMPORT_GUESTRPC_PROTOCOL       0x49435052 /* "RPCI" */
+#define VMPORT_GUESTRPC_COOKIE_FLAG    0x80000000
+#define VMPORT_GUESTRPC_MAX_CHANNELS   128
+#define VMPORT_GUESTRPC_MAX_MESSAGE    (64 * 1024)
+
+typedef enum VMPortGuestRPCType {
+    VMPORT_GUESTRPC_OPEN,
+    VMPORT_GUESTRPC_SENDSIZE,
+    VMPORT_GUESTRPC_SENDPAYLOAD,
+    VMPORT_GUESTRPC_RECVSIZE,
+    VMPORT_GUESTRPC_RECVPAYLOAD,
+    VMPORT_GUESTRPC_RECVSTATUS,
+    VMPORT_GUESTRPC_CLOSE,
+} VMPortGuestRPCType;
+
+#define VMPORT_GUESTRPC_SUCCESS        0x0001
+#define VMPORT_GUESTRPC_DORECV         0x0002
+#define VMPORT_GUESTRPC_CLOSED         0x0004
+
+typedef struct VMPortGuestRPCChannel {
+    bool open;
+    uint8_t *request;
+    uint32_t request_size;
+    uint32_t request_pos;
+    const char *reply;
+    uint32_t reply_size;
+    uint32_t reply_pos;
+} VMPortGuestRPCChannel;
+
 /* Compatibility flags for migration */
 #define VMPORT_COMPAT_READ_SET_EAX_BIT              0
 #define VMPORT_COMPAT_SIGNAL_UNSUPPORTED_CMD_BIT    1
@@ -76,6 +106,8 @@ struct VMPortState {
     uint8_t vmware_vmx_type;
 
     uint32_t compat_flags;
+
+    VMPortGuestRPCChannel guestrpc[VMPORT_GUESTRPC_MAX_CHANNELS];
 };
 
 static VMPortState *port_state;
@@ -154,6 +186,252 @@ static void vmport_ioport_write(void *opaque, hwaddr addr,
     cpu->env.regs[R_EAX] = vmport_ioport_read(opaque, addr, 4);
 }
 
+static uint32_t vmport_guestrpc_status(X86CPU *cpu, uint16_t status)
+{
+    CPUX86State *env = &cpu->env;
+
+    env->regs[R_ECX] = (uint32_t)((env->regs[R_ECX] & 0xffff) |
+                                  ((uint32_t)status << 16));
+    return env->regs[R_EAX];
+}
+
+static VMPortGuestRPCChannel *vmport_guestrpc_channel(VMPortState *s,
+                                                       uint16_t id)
+{
+    VMPortGuestRPCChannel *channel;
+
+    if (id == 0 || id > VMPORT_GUESTRPC_MAX_CHANNELS) {
+        return NULL;
+    }
+
+    channel = &s->guestrpc[id - 1];
+    return channel->open ? channel : NULL;
+}
+
+static void vmport_guestrpc_reset_channel(VMPortGuestRPCChannel *channel)
+{
+    g_free(channel->request);
+    memset(channel, 0, sizeof(*channel));
+}
+
+static GString *vmport_guestrpc_format_line(const char *prefix,
+                                             const uint8_t *message,
+                                             size_t size)
+{
+    GString *line = g_string_new(prefix);
+    size_t i;
+
+    for (i = 0; i < size; i++) {
+        uint8_t c = message[i];
+
+        switch (c) {
+        case '\r':
+            g_string_append(line, "\\r");
+            break;
+        case '\n':
+            g_string_append(line, "\\n");
+            break;
+        case '\t':
+            g_string_append(line, "\\t");
+            break;
+        default:
+            if (c < 0x20 || c == 0x7f) {
+                g_string_append_printf(line, "\\x%02x", c);
+            } else {
+                g_string_append_c(line, c);
+            }
+            break;
+        }
+    }
+
+    return line;
+}
+
+static void vmport_guestrpc_print_log(const uint8_t *message, size_t size)
+{
+    GString *line = vmport_guestrpc_format_line("vmport-log: ",
+                                                 message, size);
+
+    fprintf(stderr, "%s\n", line->str);
+    fflush(stderr);
+    g_string_free(line, true);
+}
+
+static void vmport_guestrpc_print_rpc(const uint8_t *message, size_t size)
+{
+    GString *line;
+
+    if (!qemu_loglevel_mask(LOG_UNIMP)) {
+        return;
+    }
+
+    line = vmport_guestrpc_format_line("vmport-rpc: ", message, size);
+    qemu_log_mask(LOG_UNIMP, "%s\n", line->str);
+    g_string_free(line, true);
+}
+
+static void vmport_guestrpc_finish_request(VMPortGuestRPCChannel *channel)
+{
+    static const char success_reply[] = "1 ";
+    static const char build_type_reply[] = "1 debug";
+    static const char miniport_logging_reply[] = "1 TRUE";
+    static const char present_loglevel_reply[] = "1 9";
+    static const char miniport_loglevel_reply[] = "1 9";
+    static const char vsync_reply[] = "1 FALSE";
+    static const char unknown_reply[] = "0 Unknown command";
+
+    if (channel->request_size ==
+            sizeof("info-get guestinfo.svga.wddm.buildType") - 1 &&
+        !memcmp(channel->request,
+                "info-get guestinfo.svga.wddm.buildType",
+                sizeof("info-get guestinfo.svga.wddm.buildType") - 1)) {
+        channel->reply = build_type_reply;
+        channel->reply_size = sizeof(build_type_reply) - 1;
+    } else if (channel->request_size ==
+                   sizeof("info-get guestinfo.svga.wddm.miniportLogging") - 1 &&
+               !memcmp(channel->request,
+                       "info-get guestinfo.svga.wddm.miniportLogging",
+                       sizeof("info-get guestinfo.svga.wddm.miniportLogging") - 1)) {
+        channel->reply = miniport_logging_reply;
+        channel->reply_size = sizeof(miniport_logging_reply) - 1;
+    } else if (channel->request_size ==
+                   sizeof("info-get guestinfo.loglevel.vm3d.present") - 1 &&
+               !memcmp(channel->request,
+                       "info-get guestinfo.loglevel.vm3d.present",
+                       sizeof("info-get guestinfo.loglevel.vm3d.present") - 1)) {
+        channel->reply = present_loglevel_reply;
+        channel->reply_size = sizeof(present_loglevel_reply) - 1;
+    } else if (channel->request_size ==
+                   sizeof("info-get guestinfo.loglevel.vm3d.miniport") - 1 &&
+               !memcmp(channel->request,
+                       "info-get guestinfo.loglevel.vm3d.miniport",
+                       sizeof("info-get guestinfo.loglevel.vm3d.miniport") - 1)) {
+        channel->reply = miniport_loglevel_reply;
+        channel->reply_size = sizeof(miniport_loglevel_reply) - 1;
+    } else if (channel->request_size ==
+                   sizeof("info-get guestinfo.svga.wddm.enableVSync") - 1 &&
+               !memcmp(channel->request,
+                       "info-get guestinfo.svga.wddm.enableVSync",
+                       sizeof("info-get guestinfo.svga.wddm.enableVSync") - 1)) {
+        channel->reply = vsync_reply;
+        channel->reply_size = sizeof(vsync_reply) - 1;
+    } else if (channel->request_size >= 4 &&
+               !memcmp(channel->request, "log ", 4)) {
+        vmport_guestrpc_print_log(channel->request + 4,
+                                  channel->request_size - 4);
+        channel->reply = success_reply;
+        channel->reply_size = sizeof(success_reply) - 1;
+    } else {
+        vmport_guestrpc_print_rpc(channel->request, channel->request_size);
+        channel->reply = unknown_reply;
+        channel->reply_size = sizeof(unknown_reply) - 1;
+    }
+    channel->reply_pos = 0;
+}
+
+/*
+ * Implement only the low-bandwidth form of BDOOR_CMD_MESSAGE.  In particular,
+ * never advertise MESSAGE_STATUS_HB, so guests send payloads as 4-byte chunks
+ * through the normal 0x5658 port and do not switch to the 0x5659 HB port.
+ */
+static uint32_t vmport_cmd_message(void *opaque, uint32_t addr)
+{
+    VMPortState *s = opaque;
+    X86CPU *cpu = X86_CPU(current_cpu);
+    CPUX86State *env = &cpu->env;
+    uint16_t type = env->regs[R_ECX] >> 16;
+    uint16_t id = env->regs[R_EDX] >> 16;
+    VMPortGuestRPCChannel *channel;
+    uint32_t value;
+    uint32_t remaining;
+    uint32_t count;
+    uint32_t i;
+
+    switch (type) {
+    case VMPORT_GUESTRPC_OPEN:
+        value = env->regs[R_EBX];
+        if ((value & ~VMPORT_GUESTRPC_COOKIE_FLAG) !=
+            VMPORT_GUESTRPC_PROTOCOL) {
+            return vmport_guestrpc_status(cpu, 0);
+        }
+
+        for (i = 0; i < VMPORT_GUESTRPC_MAX_CHANNELS; i++) {
+            if (!s->guestrpc[i].open) {
+                channel = &s->guestrpc[i];
+                vmport_guestrpc_reset_channel(channel);
+                channel->open = true;
+                env->regs[R_EDX] = (uint32_t)((env->regs[R_EDX] & 0xffff) |
+                                              ((i + 1) << 16));
+                env->regs[R_ESI] = 0;
+                env->regs[R_EDI] = 0;
+                return vmport_guestrpc_status(cpu,
+                                              VMPORT_GUESTRPC_SUCCESS);
+            }
+        }
+        return vmport_guestrpc_status(cpu, 0);
+
+    case VMPORT_GUESTRPC_SENDSIZE:
+        channel = vmport_guestrpc_channel(s, id);
+        if (!channel) {
+            return vmport_guestrpc_status(cpu, 0);
+        }
+
+        value = env->regs[R_EBX];
+        if (value > VMPORT_GUESTRPC_MAX_MESSAGE) {
+            return vmport_guestrpc_status(cpu, 0);
+        }
+
+        g_free(channel->request);
+        channel->request = NULL;
+        channel->request_size = value;
+        channel->request_pos = 0;
+        channel->reply = NULL;
+        channel->reply_size = 0;
+        channel->reply_pos = 0;
+
+        if (value) {
+            channel->request = g_try_malloc(value);
+            if (!channel->request) {
+                channel->request_size = 0;
+                return vmport_guestrpc_status(cpu, 0);
+            }
+        } else {
+            vmport_guestrpc_finish_request(channel);
+        }
+        return vmport_guestrpc_status(cpu, VMPORT_GUESTRPC_SUCCESS);
+
+    case VMPORT_GUESTRPC_SENDPAYLOAD:
+        channel = vmport_guestrpc_channel(s, id);
+        if (!channel || !channel->request ||
+            channel->request_pos >= channel->request_size) {
+            return vmport_guestrpc_status(cpu, 0);
+        }
+
+        value = env->regs[R_EBX];
+        remaining = channel->request_size - channel->request_pos;
+        count = MIN(remaining, 4u);
+        for (i = 0; i < count; i++) {
+            channel->request[channel->request_pos++] = value >> (i * 8);
+        }
+        if (channel->request_pos == channel->request_size) {
+            vmport_guestrpc_finish_request(channel);
+        }
+        return vmport_guestrpc_status(cpu, VMPORT_GUESTRPC_SUCCESS);
+
+    case VMPORT_GUESTRPC_RECVSIZE:
+        channel = vmport_guestrpc_channel(s, id);
+        if (!channel) {
+            return vmport_guestrpc_status(cpu, 0);
+        }
+        if (!channel->reply) {
+            return vmport_guestrpc_status(cpu, VMPORT_GUESTRPC_SUCCESS);
+        }
+
+        channel->reply_pos = 0;
+        env->regs[R_EBX] = channel->reply_size;
+        env->regs[R_EDX] = (uint32_t)((env->regs[R_EDX] & 0xffff) |
+                                      (VMPORT_GUESTRPC_SENDSIZE << 16));
+        return vmport_guestrpc_status(cpu, VMPORT_GUESTRPC_SUCCESS |
+                                      VMPORT_GUESTRPC_DORECV);
+
+    case VMPORT_GUESTRPC_RECVPAYLOAD:
+        channel = vmport_guestrpc_channel(s, id);
+        if (!channel || !channel->reply ||
+            channel->reply_pos >= channel->reply_size) {
+            return vmport_guestrpc_status(cpu, 0);
+        }
+
+        remaining = channel->reply_size - channel->reply_pos;
+        count = MIN(remaining, 4u);
+        value = 0;
+        for (i = 0; i < count; i++) {
+            value |= (uint32_t)(uint8_t)channel->reply[channel->reply_pos++]
+                     << (i * 8);
+        }
+        env->regs[R_EBX] = value;
+        env->regs[R_EDX] = (uint32_t)((env->regs[R_EDX] & 0xffff) |
+                                      (VMPORT_GUESTRPC_SENDPAYLOAD << 16));
+        return vmport_guestrpc_status(cpu, VMPORT_GUESTRPC_SUCCESS);
+
+    case VMPORT_GUESTRPC_RECVSTATUS:
+        channel = vmport_guestrpc_channel(s, id);
+        return vmport_guestrpc_status(cpu, channel ?
+                                      VMPORT_GUESTRPC_SUCCESS : 0);
+
+    case VMPORT_GUESTRPC_CLOSE:
+        channel = vmport_guestrpc_channel(s, id);
+        if (!channel) {
+            return vmport_guestrpc_status(cpu, 0);
+        }
+        vmport_guestrpc_reset_channel(channel);
+        return vmport_guestrpc_status(cpu, VMPORT_GUESTRPC_SUCCESS |
+                                      VMPORT_GUESTRPC_CLOSED);
+
+    default:
+        return vmport_guestrpc_status(cpu, 0);
+    }
+}
+
 static uint32_t vmport_cmd_get_version(void *opaque, uint32_t addr)
 {
     X86CPU *cpu = X86_CPU(current_cpu);
@@ -244,6 +522,7 @@ static void vmport_realizefn(DeviceState *dev, Error **errp)
     /* Register some generic port commands */
     vmport_register(VMPORT_CMD_GETVERSION, vmport_cmd_get_version, NULL);
     vmport_register(VMPORT_CMD_GETRAMSIZE, vmport_cmd_ram_size, NULL);
+    vmport_register(VMPORT_CMD_MESSAGE, vmport_cmd_message, s);
     if (s->compat_flags & VMPORT_COMPAT_CMDS_V2) {
         vmport_register(VMPORT_CMD_GETBIOSUUID, vmport_cmd_get_bios_uuid, NULL);
         vmport_register(VMPORT_CMD_GETHZ, vmport_cmd_get_hz, NULL);

--- a/target/i386/kvm/kvm.c
+++ b/target/i386/kvm/kvm.c
@@ -5985,6 +5985,599 @@
     }
 }
 
+#include "qom/object.h"
+#include "hw/core/cpu.h"
+
+#define KVM_VMPORT_TSS_ORIGINAL_LIMIT       0x0067
+#define KVM_VMPORT_TSS_LEGACY_IOMAP_BASE    0x0068
+#define KVM_VMPORT_TSS_PDA_IOMAP_BASE       0x0080
+#define KVM_VMPORT_TSS_PDA_TSS_SPARE        0x0068
+#define KVM_VMPORT_TSS_PDA_KERNEL_GS_BASE   0x0070
+#define KVM_VMPORT_TSS_PDA_IDLE_STACK       0x0078
+#define KVM_VMPORT_TSS_VMWARE_BYTE          (0x5658 >> 3)
+#define KVM_VMPORT_TSS_IOMAP_BYTES          (KVM_VMPORT_TSS_VMWARE_BYTE + 2)
+#define KVM_VMPORT_TSS_LEGACY_IOMAP_LIMIT   \
+    (KVM_VMPORT_TSS_LEGACY_IOMAP_BASE + KVM_VMPORT_TSS_IOMAP_BYTES - 1)
+#define KVM_VMPORT_TSS_PDA_IOMAP_LIMIT      \
+    (KVM_VMPORT_TSS_PDA_IOMAP_BASE + KVM_VMPORT_TSS_IOMAP_BYTES - 1)
+#define KVM_VMPORT_TSS_PRE_LMA_PROBE_US     1000000LL
+#define KVM_VMPORT_TSS_PROBE_US             10000LL
+#define KVM_VMPORT_TSS_DIAG_US              1000000LL
+
+/*
+ * 0 = unresolved, 1 = disabled, 2 = probing, 3 = complete.
+ */
+static int kvm_vmport_tss_feature_state;
+static int kvm_vmport_tss_debug;
+static int64_t kvm_vmport_tss_next_probe[256];
+static int64_t kvm_vmport_tss_next_diag[256];
+static int kvm_vmport_tss_seen_lma[256];
+static int kvm_vmport_tss_done[256];
+
+#define KVM_VMPORT_TSS_LOG(...)                                          \
+    do {                                                                 \
+        if (unlikely(qatomic_read(&kvm_vmport_tss_debug))) {             \
+            fprintf(stderr, __VA_ARGS__);                                \
+        }                                                                \
+    } while (0)
+
+/* Called with the BQL held. */
+static bool kvm_vmport_tss_feature_enabled(void)
+{
+    int state = qatomic_read(&kvm_vmport_tss_feature_state);
+    Object *vmport;
+    Object *vmvga;
+    bool enable_3d;
+
+    if (state != 0) {
+        return state == 2;
+    }
+
+    vmvga = object_resolve_path_type("", "vmvga", NULL);
+    if (!vmvga) {
+        qatomic_set(&kvm_vmport_tss_feature_state, 1);
+        return false;
+    }
+
+    qatomic_set(&kvm_vmport_tss_debug,
+                object_property_get_bool(vmvga, "debug", NULL));
+
+    vmport = object_resolve_path_type("", "vmport", NULL);
+    if (!vmport) {
+        qatomic_set(&kvm_vmport_tss_feature_state, 1);
+        KVM_VMPORT_TSS_LOG(
+            "vmport-tss: disabled, vmport device absent\n");
+        return false;
+    }
+
+    enable_3d = object_property_get_bool(vmvga, "3d", NULL);
+    if (!enable_3d) {
+        qatomic_set(&kvm_vmport_tss_feature_state, 1);
+        KVM_VMPORT_TSS_LOG(
+            "vmport-tss: disabled, vmvga 3d=off\n");
+        return false;
+    }
+
+    qatomic_set(&kvm_vmport_tss_feature_state, 2);
+    KVM_VMPORT_TSS_LOG(
+        "vmport-tss: armed, vmvga 3d enabled; pre-long-mode probes every "
+        "1 s; probing x64 TSS every 10 ms until all vcpus are configured\n");
+    return true;
+}
+
+static bool kvm_vmport_tss_all_done(void)
+{
+    CPUState *cs;
+
+    CPU_FOREACH(cs) {
+        unsigned int index = cs->cpu_index;
+
+        if (index >= ARRAY_SIZE(kvm_vmport_tss_done) ||
+            !qatomic_read(&kvm_vmport_tss_done[index])) {
+            return false;
+        }
+    }
+
+    return true;
+}
+
+static bool kvm_vmport_tss_diag_due(CPUState *cs)
+{
+    unsigned int index = cs->cpu_index;
+    int64_t now;
+
+    if (!qatomic_read(&kvm_vmport_tss_debug) ||
+        index >= ARRAY_SIZE(kvm_vmport_tss_next_diag)) {
+        return false;
+    }
+
+    now = g_get_monotonic_time();
+    if (now < kvm_vmport_tss_next_diag[index]) {
+        return false;
+    }
+
+    kvm_vmport_tss_next_diag[index] = now + KVM_VMPORT_TSS_DIAG_US;
+    return true;
+}
+
+static void kvm_vmport_tss_diag(CPUState *cs,
+                                const struct kvm_sregs *sregs,
+                                int iomap, const char *reason)
+{
+    unsigned int lma = !!(sregs->efer & MSR_EFER_LMA);
+
+    if (!kvm_vmport_tss_diag_due(cs)) {
+        return;
+    }
+
+    if (iomap >= 0) {
+        KVM_VMPORT_TSS_LOG(
+                "vmport-tss: probe vcpu=%d lma=%u present=%u type=%u "
+                "base=0x%" PRIx64 " limit=0x%x iomap=0x%04x reason=%s\n",
+                cs->cpu_index, lma, (unsigned int)sregs->tr.present,
+                (unsigned int)sregs->tr.type, (uint64_t)sregs->tr.base,
+                sregs->tr.limit, (unsigned int)iomap, reason);
+    } else {
+        KVM_VMPORT_TSS_LOG(
+                "vmport-tss: probe vcpu=%d lma=%u present=%u type=%u "
+                "base=0x%" PRIx64 " limit=0x%x iomap=unknown reason=%s\n",
+                cs->cpu_index, lma, (unsigned int)sregs->tr.present,
+                (unsigned int)sregs->tr.type, (uint64_t)sregs->tr.base,
+                sregs->tr.limit, reason);
+    }
+}
+
+static uint64_t kvm_vmport_tss_get_le64(const uint8_t *p)
+{
+    uint64_t value;
+
+    memcpy(&value, p, sizeof(value));
+    return le64_to_cpu(value);
+}
+
+static bool kvm_vmport_tss_is_kernel_pointer(uint64_t value)
+{
+    return (value >> 48) == 0xffff;
+}
+
+/*
+ * KVA-shadowed x64 Windows uses a KPROCESSOR_DESCRIPTOR_AREA layout with
+ * TssSpare (+0x68), KernelGsBase (+0x70), IdleStack (+0x78), and then the
+ * explicitly reserved TssPad beginning at +0x80.  Do not depend on the TSS
+ * virtual address alone.  Require page alignment together with stable post-TSS
+ * fields before ever treating TssPad as bitmap storage.  IdleStack may be NULL
+ * on Windows builds that do not populate that optional pointer.
+ */
+static bool kvm_vmport_tss_is_processor_descriptor_area(CPUState *cs,
+                                                         uint64_t base)
+{
+    uint8_t first[0x18];
+    uint8_t second[0x18];
+    uint64_t tss_spare;
+    uint64_t kernel_gs_base;
+    uint64_t idle_stack;
+    int ret;
+
+    ret = cpu_memory_rw_debug(cs, base + KVM_VMPORT_TSS_PDA_TSS_SPARE,
+                              first, sizeof(first), false);
+    if (ret != 0) {
+        return false;
+    }
+    ret = cpu_memory_rw_debug(cs, base + KVM_VMPORT_TSS_PDA_TSS_SPARE,
+                              second, sizeof(second), false);
+    if (ret != 0 || memcmp(first, second, sizeof(first)) != 0) {
+        return false;
+    }
+
+    tss_spare = kvm_vmport_tss_get_le64(first);
+    kernel_gs_base = kvm_vmport_tss_get_le64(
+        first + KVM_VMPORT_TSS_PDA_KERNEL_GS_BASE -
+        KVM_VMPORT_TSS_PDA_TSS_SPARE);
+    idle_stack = kvm_vmport_tss_get_le64(
+        first + KVM_VMPORT_TSS_PDA_IDLE_STACK -
+        KVM_VMPORT_TSS_PDA_TSS_SPARE);
+
+    if ((base & 0xfff) != 0 || tss_spare != 0 ||
+        !kvm_vmport_tss_is_kernel_pointer(kernel_gs_base) ||
+        (idle_stack != 0 && !kvm_vmport_tss_is_kernel_pointer(idle_stack))) {
+        if (kvm_vmport_tss_diag_due(cs)) {
+            fprintf(stderr,
+                    "vmport-tss: vcpu=%d pda-fingerprint-miss "
+                    "base=0x%" PRIx64 " spare=0x%" PRIx64
+                    " kernel-gs=0x%" PRIx64 " idle-stack=0x%" PRIx64 "\n",
+                    cs->cpu_index, base, tss_spare, kernel_gs_base,
+                    idle_stack);
+        }
+        return false;
+    }
+
+    KVM_VMPORT_TSS_LOG(
+            "vmport-tss: vcpu=%d detected processor-descriptor-area "
+            "layout base=0x%" PRIx64 " kernel-gs=0x%" PRIx64
+            " idle-stack=0x%" PRIx64 "\n",
+            cs->cpu_index, base, kernel_gs_base, idle_stack);
+    return true;
+}
+
+static bool kvm_vmport_tss_validate_unused_map_area(CPUState *cs,
+                                                     uint64_t base,
+                                                     uint16_t iomap_base,
+                                                     const char *layout)
+{
+    uint8_t first[KVM_VMPORT_TSS_IOMAP_BYTES];
+    uint8_t second[KVM_VMPORT_TSS_IOMAP_BYTES];
+    size_t i;
+    int ret;
+
+    /*
+     * Sample the complete candidate bitmap twice without resuming this vCPU.
+     * Zero/stable storage is required even for a documented padding layout:
+     * if Windows has repurposed it on a different build, do not touch it.
+     */
+    ret = cpu_memory_rw_debug(cs, base + iomap_base,
+                              first, sizeof(first), false);
+    if (ret != 0) {
+        KVM_VMPORT_TSS_LOG(
+                "vmport-tss: vcpu=%d reject=IOMAP_AREA_READ1 layout=%s "
+                "ret=%d address=0x%" PRIx64 " size=0x%zx\n",
+                cs->cpu_index, layout, ret, base + iomap_base,
+                sizeof(first));
+        return false;
+    }
+
+    ret = cpu_memory_rw_debug(cs, base + iomap_base,
+                              second, sizeof(second), false);
+    if (ret != 0) {
+        KVM_VMPORT_TSS_LOG(
+                "vmport-tss: vcpu=%d reject=IOMAP_AREA_READ2 layout=%s "
+                "ret=%d address=0x%" PRIx64 " size=0x%zx\n",
+                cs->cpu_index, layout, ret, base + iomap_base,
+                sizeof(second));
+        return false;
+    }
+
+    if (memcmp(first, second, sizeof(first)) != 0) {
+        if (unlikely(qatomic_read(&kvm_vmport_tss_debug))) {
+            for (i = 0; i < sizeof(first); i++) {
+                if (first[i] != second[i]) {
+                    fprintf(stderr,
+                            "vmport-tss: vcpu=%d "
+                            "reject=IOMAP_AREA_UNSTABLE layout=%s "
+                            "offset=+0x%zx first=0x%02x second=0x%02x\n",
+                            cs->cpu_index, layout, i,
+                            first[i], second[i]);
+                    break;
+                }
+            }
+        }
+        return false;
+    }
+
+    for (i = 0; i < sizeof(first); i++) {
+        if (first[i] != 0) {
+            if (kvm_vmport_tss_diag_due(cs)) {
+                fprintf(stderr,
+                        "vmport-tss: vcpu=%d reject=IOMAP_AREA_IN_USE "
+                        "layout=%s iomap=0x%04x offset=+0x%zx "
+                        "value=0x%02x\n",
+                        cs->cpu_index, layout, iomap_base, i, first[i]);
+            }
+            return false;
+        }
+    }
+
+    KVM_VMPORT_TSS_LOG(
+            "vmport-tss: vcpu=%d bitmap storage verified layout=%s "
+            "iomap=0x%04x bytes=%zu\n",
+            cs->cpu_index, layout, iomap_base, sizeof(first));
+    return true;
+}
+
+static bool kvm_vmport_tss_select_layout(CPUState *cs, uint64_t base,
+                                         uint16_t *iomap_base,
+                                         uint32_t *iomap_limit,
+                                         const char **layout)
+{
+    if (kvm_vmport_tss_is_processor_descriptor_area(cs, base)) {
+        *iomap_base = KVM_VMPORT_TSS_PDA_IOMAP_BASE;
+        *iomap_limit = KVM_VMPORT_TSS_PDA_IOMAP_LIMIT;
+        *layout = "processor-descriptor-area/tss-pad";
+        return kvm_vmport_tss_validate_unused_map_area(
+            cs, base, *iomap_base, *layout);
+    }
+
+    *iomap_base = KVM_VMPORT_TSS_LEGACY_IOMAP_BASE;
+    *iomap_limit = KVM_VMPORT_TSS_LEGACY_IOMAP_LIMIT;
+    *layout = "legacy-x64-reserved-extension";
+    return kvm_vmport_tss_validate_unused_map_area(
+        cs, base, *iomap_base, *layout);
+}
+
+static bool kvm_vmport_tss_verify_map(CPUState *cs, uint64_t base,
+                                      uint16_t iomap_base,
+                                      const uint8_t *expected)
+{
+    uint8_t verify[KVM_VMPORT_TSS_IOMAP_BYTES];
+    size_t i;
+    int ret;
+
+    ret = cpu_memory_rw_debug(cs, base + iomap_base,
+                              verify, sizeof(verify), false);
+    if (ret == 0 && memcmp(verify, expected, sizeof(verify)) == 0) {
+        KVM_VMPORT_TSS_LOG(
+                "vmport-tss: vcpu=%d bitmap readback verified iomap=0x%04x "
+                "bytes=%zu vmware-byte[+0x%x]=0x%02x\n",
+                cs->cpu_index, iomap_base, sizeof(verify),
+                KVM_VMPORT_TSS_VMWARE_BYTE,
+                verify[KVM_VMPORT_TSS_VMWARE_BYTE]);
+        return true;
+    }
+
+    if (unlikely(qatomic_read(&kvm_vmport_tss_debug))) {
+        fprintf(stderr,
+                "vmport-tss: vcpu=%d reject=VERIFY_MAP iomap=0x%04x ret=%d",
+                cs->cpu_index, iomap_base, ret);
+        if (ret == 0) {
+            for (i = 0; i < sizeof(verify); i++) {
+                if (verify[i] != expected[i]) {
+                    fprintf(stderr,
+                            " first-mismatch=+0x%zx expected=0x%02x got=0x%02x",
+                            i, expected[i], verify[i]);
+                    break;
+                }
+            }
+        }
+        fputc('\n', stderr);
+    }
+
+    return false;
+}
+
+static bool kvm_vmport_tss_set_iomap_base(CPUState *cs, uint64_t base,
+                                           uint16_t old_iomap,
+                                           uint16_t new_iomap)
+{
+    uint8_t old_bytes[2] = { old_iomap & 0xff, old_iomap >> 8 };
+    uint8_t new_bytes[2] = { new_iomap & 0xff, new_iomap >> 8 };
+    uint8_t verify[2];
+    int ret;
+
+    if (old_iomap == new_iomap) {
+        return true;
+    }
+
+    ret = cpu_memory_rw_debug(cs, base + 0x66,
+                              new_bytes, sizeof(new_bytes), true);
+    if (ret == 0) {
+        ret = cpu_memory_rw_debug(cs, base + 0x66,
+                                  verify, sizeof(verify), false);
+    }
+    if (ret == 0 && memcmp(verify, new_bytes, sizeof(verify)) == 0) {
+        KVM_VMPORT_TSS_LOG(
+                "vmport-tss: vcpu=%d IoMapBase moved 0x%04x -> 0x%04x\n",
+                cs->cpu_index, old_iomap, new_iomap);
+        return true;
+    }
+
+    /* Keep the architectural TSS disabled if changing IoMapBase failed. */
+    cpu_memory_rw_debug(cs, base + 0x66,
+                        old_bytes, sizeof(old_bytes), true);
+    KVM_VMPORT_TSS_LOG(
+            "vmport-tss: vcpu=%d reject=IOMAP_BASE_WRITE old=0x%04x "
+            "new=0x%04x ret=%d\n",
+            cs->cpu_index, old_iomap, new_iomap, ret);
+    return false;
+}
+
+/*
+ * Try to install the bitmap before VMware's user-mode driver can execute the
+ * backdoor IN instruction.  The TSS is sampled twice back-to-back; a valid
+ * sample is never allowed to resume the guest between qualification and the
+ * bitmap installation.
+ *
+ * Called with the BQL held.
+ */
+static void kvm_vmport_tss_enable_user_io(X86CPU *cpu)
+{
+    CPUState *cs = CPU(cpu);
+    CPUX86State *env = &cpu->env;
+    unsigned int index = cs->cpu_index;
+    struct kvm_sregs first;
+    struct kvm_sregs second;
+    uint8_t io_map_base[2];
+    uint8_t io_map_base2[2];
+    uint8_t io_map[KVM_VMPORT_TSS_IOMAP_BYTES];
+    uint16_t iomap;
+    uint16_t iomap2;
+    uint16_t selected_iomap;
+    uint32_t selected_limit;
+    const char *layout;
+    int ret;
+
+    if (index >= ARRAY_SIZE(kvm_vmport_tss_done) ||
+        qatomic_read(&kvm_vmport_tss_done[index]) ||
+        qatomic_read(&kvm_vmport_tss_feature_state) != 2) {
+        return;
+    }
+
+    ret = kvm_vcpu_ioctl(cs, KVM_GET_SREGS, &first);
+    if (ret < 0) {
+        return;
+    }
+
+    if (first.efer & MSR_EFER_LMA) {
+        qatomic_set(&kvm_vmport_tss_seen_lma[index], 1);
+    }
+
+    if (!(first.efer & MSR_EFER_LMA) || !first.tr.present ||
+        first.tr.type != 11 || !first.tr.base ||
+        first.tr.limit != KVM_VMPORT_TSS_ORIGINAL_LIMIT) {
+        kvm_vmport_tss_diag(cs, &first, -1, "waiting-for-windows-x64-tss");
+        return;
+    }
+
+    /*
+     * Synchronizing here gives cpu_memory_rw_debug() the current CR3 and also
+     * makes the QEMU register image authoritative.  Explicitly setting
+     * vcpu_dirty again after changing TR.limit below documents the required
+     * push before the next KVM_RUN.
+     */
+    kvm_cpu_synchronize_state(cs);
+    if (env->tr.base != first.tr.base ||
+        env->tr.limit != KVM_VMPORT_TSS_ORIGINAL_LIMIT) {
+        kvm_vmport_tss_diag(cs, &first, -1, "qemu-state-mismatch");
+        return;
+    }
+
+    ret = cpu_memory_rw_debug(cs, first.tr.base + 0x66, io_map_base,
+                              sizeof(io_map_base), false);
+    if (ret != 0) {
+        kvm_vmport_tss_diag(cs, &first, -1, "iomap-read-failed");
+        return;
+    }
+    iomap = io_map_base[0] | ((uint16_t)io_map_base[1] << 8);
+    if (iomap != KVM_VMPORT_TSS_LEGACY_IOMAP_BASE) {
+        kvm_vmport_tss_diag(cs, &first, iomap, "unexpected-iomap-base");
+        return;
+    }
+
+    /* Immediate second sample: do not resume guest execution in between. */
+    ret = kvm_vcpu_ioctl(cs, KVM_GET_SREGS, &second);
+    if (ret < 0 || !(second.efer & MSR_EFER_LMA) ||
+        !second.tr.present || second.tr.type != 11 ||
+        second.tr.base != first.tr.base ||
+        second.tr.limit != KVM_VMPORT_TSS_ORIGINAL_LIMIT) {
+        kvm_vmport_tss_diag(cs, &second, -1, "unstable-second-sample");
+        return;
+    }
+
+    ret = cpu_memory_rw_debug(cs, second.tr.base + 0x66, io_map_base2,
+                              sizeof(io_map_base2), false);
+    if (ret != 0) {
+        kvm_vmport_tss_diag(cs, &second, -1, "second-iomap-read-failed");
+        return;
+    }
+    iomap2 = io_map_base2[0] | ((uint16_t)io_map_base2[1] << 8);
+    if (iomap2 != iomap) {
+        kvm_vmport_tss_diag(cs, &second, iomap2, "unstable-iomap-base");
+        return;
+    }
+
+    if (!kvm_vmport_tss_select_layout(cs, second.tr.base,
+                                      &selected_iomap, &selected_limit,
+                                      &layout)) {
+        return;
+    }
+
+    KVM_VMPORT_TSS_LOG(
+            "vmport-tss: vcpu=%d qualified stable x64 TSS base=0x%" PRIx64
+            " limit=0x%x current-iomap=0x%04x selected-iomap=0x%04x "
+            "layout=%s installing\n",
+            cs->cpu_index, (uint64_t)second.tr.base,
+            second.tr.limit, iomap2, selected_iomap, layout);
+
+    memset(io_map, 0xff, sizeof(io_map));
+    io_map[KVM_VMPORT_TSS_VMWARE_BYTE] = 0xf0;
+
+    ret = cpu_memory_rw_debug(cs, second.tr.base + selected_iomap,
+                              io_map, sizeof(io_map), true);
+    if (ret != 0) {
+        KVM_VMPORT_TSS_LOG(
+                "vmport-tss: vcpu=%d reject=IOMAP_WRITE layout=%s ret=%d "
+                "address=0x%" PRIx64 " size=0x%zx\n",
+                cs->cpu_index, layout, ret,
+                (uint64_t)second.tr.base + selected_iomap,
+                sizeof(io_map));
+        return;
+    }
+
+    if (!kvm_vmport_tss_verify_map(cs, second.tr.base,
+                                   selected_iomap, io_map)) {
+        return;
+    }
+
+    /*
+     * Legacy Win64 already points IoMapBase at +0x68.  The processor
+     * descriptor layout has live fields there, so move IoMapBase to TssPad
+     * only after the new bitmap is fully written and verified.  TR.limit is
+     * still 0x67, therefore the map remains architecturally disabled until the
+     * register image is pushed immediately before the next KVM_RUN.
+     */
+    if (!kvm_vmport_tss_set_iomap_base(cs, second.tr.base,
+                                       iomap2, selected_iomap)) {
+        return;
+    }
+
+    env->tr.limit = selected_limit;
+    cs->vcpu_dirty = true;
+    qatomic_set(&kvm_vmport_tss_done[index], 1);
+
+    KVM_VMPORT_TSS_LOG(
+            "vmport-tss: vcpu=%d enabled user I/O 0x5658-0x565b "
+            "at TSS 0x%" PRIx64 " iomap=0x%04x limit=0x%x layout=%s\n",
+            cs->cpu_index, (uint64_t)env->tr.base,
+            selected_iomap, selected_limit, layout);
+
+    if (kvm_vmport_tss_all_done()) {
+        qatomic_set(&kvm_vmport_tss_feature_state, 3);
+        KVM_VMPORT_TSS_LOG(
+                "vmport-tss: all vcpus configured; probing stopped\n");
+    } else {
+        CPUState *other;
+
+        /* Give other currently-running vCPUs an immediate chance to qualify. */
+        CPU_FOREACH(other) {
+            unsigned int other_index = other->cpu_index;
+
